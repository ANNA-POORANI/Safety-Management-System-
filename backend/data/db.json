  "emergencyProtocols": [
    {
      "_id": "ep_001",
      "code": "SOP-EMERG-01",
      "title": "Catastrophic Toxic Vapor Release (Chlorine / Anhydrous Ammonia)",
      "category": "Gas Release",
      "alertLevel": "Level 2 - Plant Evacuation",
      "triggerConditions": "Ambient vapor concentration > 3 ppm Chlorine or > 25 ppm Ammonia at perimeter sensors or direct tank rupture.",
      "steps": [
        {
          "stepNumber": 1,
          "action": "Sound Continuous Warble Siren & trigger Plant-Wide Emergency Beacon",
          "assignedRole": "Control Room Supervisor",
          "isCrucial": true
        },
        {
          "stepNumber": 2,
          "action": "Auto-activate Deluge Water Curtains and caustic scrubber exhaust in Zone C",
          "assignedRole": "DCS Operator",
          "isCrucial": true
        },
        {
          "stepNumber": 3,
          "action": "Determine Wind Direction via ultrasonic anemometer; Broadcast Upwind Muster Point (North Point A or South Point B)",
          "assignedRole": "Safety Incident Commander",
          "isCrucial": true
        },
        {
          "stepNumber": 4,
          "action": "Deploy Hazmat Entry Team equipped with Level A Encapsulated Suits & SCBA (Positive Pressure)",
          "assignedRole": "Hazmat Response Unit",
          "isCrucial": true
        },
        {
          "stepNumber": 5,
          "action": "Notify Municipal Emergency Services (911) & Local Emergency Planning Committee (LEPC)",
          "assignedRole": "EHS Director",
          "isCrucial": false
        }
